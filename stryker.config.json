{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/main.ts",
    "!src/**/*-adapter.ts",
    "!src/**/*.d.ts"
  ],
  "testRunner": "vitest",
  "reporters": ["progress", "clear-text", "html", "json"],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 85,
    "low": 80,
    "break": 80
  },
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}
