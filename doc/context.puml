@startuml
!include C4_Context.puml

LAYOUT_WITH_LEGEND()

Person(reader, "Linux Desktop User / Developer", "Reads Markdown documentation, ADRs, specifications, and technical notes via CLI or file manager.")

System(parchment, "Parchment Markdown Viewer", "Distraction-free native Linux desktop Markdown reader (Rust + Tauri v2 + TypeScript) supporting GFM, alerts, TOC, search, KaTeX math, Mermaid diagrams, and live file auto-reload.")

System_Ext(xdg_desktop, "Linux Desktop Environment (GNOME / KDE / XDG)", "Provides file manager 'Open With' context menu integration via XDG .desktop & MIME entries, native file dialogs, and Freedesktop dark/light color-scheme preferences.")
System_Ext(local_fs, "Local File System", "Stores UTF-8 Markdown documents (.md, .markdown), relative local image assets, and user preferences ($XDG_CONFIG_HOME/parchment/config.json).")

Rel(reader, parchment, "Launches via CLI ('parchment <file>'), opens files, searches ('Ctrl+F'), navigates TOC, toggles theme", "CLI / GUI")
Rel(reader, xdg_desktop, "Right-clicks Markdown file -> 'Open With Parchment'", "XDG Desktop Action")
Rel(xdg_desktop, parchment, "Invokes executable with target file path (%F) & broadcasts color-scheme changes", "Exec / Wayland / X11 / DBus")
Rel(parchment, local_fs, "Reads UTF-8 Markdown files, resolves sandboxed relative images, watches file changes (inotify), persists config.json", "POSIX File I/O & inotify")

@enduml
