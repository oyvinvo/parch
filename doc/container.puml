@startuml
!include C4_Container.puml

LAYOUT_WITH_LEGEND()

Person(reader, "Linux Desktop User", "Interacts with the native desktop window and CLI.")

System_Boundary(parchment_boundary, "Parchment Desktop Application (Tauri v2 Process)") {
    Container(rust_core, "Parchment Rust Core", "Rust (2021 Edition) / Tauri v2 Core", "Handles CLI argument parsing, path canonicalization, UTF-8 & binary validation, directory-traversal asset sandboxing, XDG config persistence, and debounced inotify file watching.")
    Container(webview_ui, "Parchment Reader UI", "TypeScript / Vite / WebKitGTK (WRY)", "Renders sanitized GFM HTML, GitHub callout alerts, syntax-highlighted code with copy button, KaTeX math, Mermaid SVG diagrams, scroll-spy TOC, in-document search, and Light/Dark/Sepia themes.")
}

System_Ext(xdg_desktop, "Linux Desktop Environment", "GNOME / KDE / XDG MIME Registry & Display Server (Wayland/X11)")
System_Ext(local_fs, "Local File System ($HOME & $XDG_CONFIG_HOME)", "Markdown documents, relative local images, and ~/.config/parchment/config.json")

Rel(reader, rust_core, "Executes 'parchment [OPTIONS] [FILE]'", "POSIX CLI")
Rel(reader, webview_ui, "Reads documents, searches ('Ctrl+F'), navigates TOC ('Ctrl+\\'), switches themes ('F10')", "Keyboard & Pointer Events")
Rel(xdg_desktop, rust_core, "Launches via parchment.desktop ('parchment %F')", "XDG Exec")
Rel(xdg_desktop, webview_ui, "Provides prefers-color-scheme media state & system clipboard", "WebKitGTK / Wayland / X11")
Rel(webview_ui, rust_core, "Invokes IPC commands (open_document, get_user_preferences, set_user_preference, resolve_asset_path)", "Tauri IPC Bridge (JSON)")
Rel(rust_core, webview_ui, "Emits asynchronous events (document-file-changed, document-file-deleted, system-theme-changed) & serves asset:// images", "Tauri Event Channel & Asset Protocol")
Rel(rust_core, local_fs, "Reads Markdown buffers, watches inotify events, reads/writes config.json", "std::fs & notify crate")

@enduml
